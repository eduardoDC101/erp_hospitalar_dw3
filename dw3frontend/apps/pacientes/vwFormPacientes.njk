{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2" id="tituloFormulario">Formulário de pacientes</h1>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmPacientes" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="id" name="id" value="0">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-12 col-lg-3 d-none" id="grupoId">
            <label for="idVisivel" class="form-label">ID</label>
            <input type="text" class="form-control" id="idVisivel" value="" disabled>
          </div>

          <div class="col-12">
            <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="nome" name="nome" maxlength="100" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="cpf" class="form-label">CPF <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="cpf" name="cpf" inputmode="numeric" pattern="\d{11}" maxlength="11" required title="Informe exatamente 11 dígitos numéricos.">
          </div>

          <div class="col-12 col-md-4">
            <label for="telefone" class="form-label">Telefone</label>
            <input type="tel" class="form-control" id="telefone" name="telefone" maxlength="20">
          </div>

          <div class="col-12 col-md-4">
            <label for="data_nascimento" class="form-label">Data de nascimento <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="data_nascimento" name="data_nascimento" required>
          </div>
        </div>

        <div class="form-actions d-flex flex-column flex-sm-row gap-2">
          <button type="button" class="btn btn-primary d-none" id="btnInserirPaciente">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPaciente" disabled>
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPaciente" disabled>
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/pacientes" id="btnFecharPaciente">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/pacientes/vwFormPacientes.js"></script>
{% endblock %}
